{
  "name": "cooktracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nutrily monorepo containing mobile app and backend frame extraction server",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix app install",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "dev:app": "npm --prefix app start",
    "start:app": "npm --prefix app start",
    "android:app": "npm --prefix app run android",
    "ios:app": "npm --prefix app run ios",
    "typecheck:app": "npm --prefix app run typecheck",
    "verify:env": "node server/scripts/verify-env.js",
    "db:link": "npx supabase link",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
