# ==============================================================================
# Nutrily Server Environment Configuration
# Copy this file to .env and fill in the values: cp .env.example .env
# ==============================================================================

# Server Port
PORT=3001

# Supabase Configuration
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API (Used for AI recipe parsing and recipe generation)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq API (Used for Whisper audio transcription from video files)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Google Cloud Vision API (Used for OCR on video frames)
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Pexels API (Used for fetching high quality food imagery for recipes)
# Get from: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# RevenueCat Webhooks (Used to verify incoming subscription events)
# Get from: RevenueCat Dashboard -> Project -> Webhooks -> Authorization Header
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
