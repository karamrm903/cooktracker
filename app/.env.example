# ==============================================================================
# Nutrily Mobile App Environment Configuration
# Copy this file to .env and fill in the values: cp .env.example .env
# Note: Variables prefixed with EXPO_PUBLIC_ are bundled into the client app.
# ==============================================================================

# Supabase Configuration
# Get these from your Supabase Dashboard: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Server URL
# For iOS Simulator: http://localhost:3001
# For Android Emulator: http://10.0.2.2:3001
# For Physical Device: http://<your-mac-local-ip>:3001 (e.g., http://192.168.1.50:3001)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google Sign-In OAuth Client IDs
# Get these from: Google Cloud Console -> APIs & Services -> Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# RevenueCat In-App Purchases Public SDK Keys
# Get from: RevenueCat Dashboard -> Project Settings -> API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_revenuecat_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_revenuecat_key

# Optional / Feature-Specific API Keys
# YouTube Data v3 API Key (for client-side video metadata fetching)
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-data-api-key
