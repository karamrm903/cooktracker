{
  "expo": {
    "newArchEnabled": false,
    "name": "Nutrily",
    "slug": "nutrily",
    "scheme": "nutrily",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macrosai.nutrily"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35"
      },
      "package": "com.macrosai.nutrily",
      "edgeToEdge": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nutrily",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.102659338047-0t0mk34u2kaub0f4hboq175nt7ssorin"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-localization"
    ]
  }
}
