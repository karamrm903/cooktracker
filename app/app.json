{
  "expo": {
    "newArchEnabled": false,
    "name": "Nutrily",
    "slug": "nutrily",
    "scheme": "nutrily",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macrosai.nutrily",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Nutrily to access your camera to scan plates and recognize food.",
        "NSPhotoLibraryUsageDescription": "Allow Nutrily to access your photos to select meal pictures.",
        "NSMicrophoneUsageDescription": "Allow Nutrily to access your microphone for camera features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35"
      },
      "package": "com.macrosai.nutrily",
      "edgeToEdge": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "nutrily", "host": "auth", "pathPrefix": "/callback" },
            { "scheme": "nutrily" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.102659338047-0t0mk34u2kaub0f4hboq175nt7ssorin"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nutrily to access your camera to scan plates and recognize food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nutrily to access your photos to select meal pictures."
        }
      ]
    ]
  }
}
